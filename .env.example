# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VAPI_API_KEY: Secret key from Vapi dashboard.
VAPI_API_KEY=""
# VAPI_PUBLIC_KEY: Public key for the Web SDK.
VAPI_PUBLIC_KEY=""
# VAPI_ASSISTANT_ID: The ID of your configured Vapi assistant.
VAPI_ASSISTANT_ID=""

# QDRANT_URL: Your Qdrant instance URL (e.g., https://your-id.cloud.qdrant.io).
QDRANT_URL=""
# QDRANT_API_KEY: Authentication key for your Qdrant instance.
QDRANT_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
